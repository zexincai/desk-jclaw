{
  "name": "jclaw-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite --mode electron",
    "build": "vue-tsc -b && vite build",
    "build:staging": "vue-tsc -b && vite build --mode staging",
    "build:pre": "vue-tsc -b && vite build --mode pre",
    "build:cos": "vue-tsc -b && vite build --mode cos",
    "build:electron": "vue-tsc -b && vite build --mode electron && electron-builder",
    "build:mac": "npm run build:electron -- --mac",
    "build:win": "npm run build:electron -- --win",
    "build:all": "npm run build:electron -- --mac --win",
    "preview": "vite preview"
  },
  "dependencies": {
    "cos-js-sdk-v5": "^1.10.1",
    "js-sha256": "^0.11.1",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.0",
    "pinia": "^3.0.4",
    "qrcodejs2-fixes": "^0.0.2",
    "tweetnacl": "^1.0.3",
    "vue": "^3.5.32",
    "wukongimjssdk": "^1.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.27",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "electron-updater": "^6.8.3",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "vite": "^6.3.2",
    "vite-plugin-electron": "^0.28.0",
    "vue-tsc": "^2.2.10"
  }
}
